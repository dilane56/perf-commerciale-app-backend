spring:
  datasource:
    url: jdbc:sqlserver://localhost:1433;databaseName=perfcommerciale;encrypt=true;trustServerCertificate=true
    username: sa
    password: change-me-locally
    driver-class-name: com.microsoft.sqlserver.jdbc.SQLServerDriver

  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  # db/demo contient un jeu de donnees de demonstration (clients, rendez-vous, transactions)
  # reserve au poste de developpement : il n'est jamais charge par les autres profils.
  flyway:
    locations: classpath:db/migration,classpath:db/demo

app:
  jwt:
    secret: change-me-locally-min-32-bytes-for-hs256
    access-token-expiration-minutes: 30
    refresh-token-expiration-days: 7
  cors:
    allowed-origins: http://localhost:3000

logging:
  level:
    com.cbcbourse.backend: DEBUG
    org.hibernate.SQL: DEBUG
